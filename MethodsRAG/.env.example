# Application Environment
ENVIRONMENT=production
DEBUG=false

# MongoDB Atlas Connection
MONGO_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here

# API Key Authentication
API_KEY=your_secure_api_key_here
TRUST_FORWARDED_IP=false

# JWT Configuration (auto-generated if not provided)
JWT_SECRET_KEY=your_jwt_secret_key_here

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com

# File Upload Configuration
MAX_UPLOAD_FILE_SIZE_MB=50
MAX_REQUEST_BODY_SIZE_MB=10

# Database Connection Pool Configuration
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# Redis Cache Configuration (optional, for distributed caching)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
GEMINI_RERANK_ENABLED=true
QUERY_EXPANSION_ENABLED=true
