# =============================================================================
# Automation Script Generator — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in real values before starting the service.
#
#   cp .env.example .env
#
# NEVER commit .env to source control — it contains secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Runtime environment. Valid values: development | staging | production
# Affects: CORS wildcard block (production), Swagger UI visibility
ENV=development

# Log verbosity. Valid values: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# When true, logs are written to service.log and service_error.log on disk.
# When false (default), logs go to stdout only (recommended for containers).
LOG_TO_FILE=false


# -----------------------------------------------------------------------------
# API Key Security  ← REQUIRED
# -----------------------------------------------------------------------------

# Enable API key enforcement. Set false ONLY for local development.
API_KEY_ENABLED=true

# Shared secret between callers and this service.
# Requirements: minimum 32 characters, not a known placeholder.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# HTTP header name that callers must include.
API_KEY_HEADER=X-API-Key

# When true, the service reads the client IP from X-Forwarded-For / X-Real-IP
# headers for rate limiting and audit logging.
# ⚠ Enable ONLY when deployed behind a trusted, sanitizing reverse proxy.
# Leaving false (default) prevents IP-spoofing attacks.
TRUST_FORWARDED_IP=false


# -----------------------------------------------------------------------------
# LLM Configuration  ← REQUIRED
# -----------------------------------------------------------------------------

# Primary LLM provider. Valid values: gemini | openai
LLM_PROVIDER=gemini

# Google Gemini API key (required when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=

# OpenAI API key (required when LLM_PROVIDER=openai, or as fallback)
OPENAI_API_KEY=

# Primary model. Also aliased as LLM_MODEL for backward compatibility.
PRIMARY_MODEL=gemini-2.5-pro

# Fallback model used when the primary model fails or is unavailable.
FALLBACK_MODEL=gemini-2.5-flash

# Max tokens in a single LLM response. Range: 256–8192.
MAX_OUTPUT_TOKENS=2048

# Concurrent LLM calls across a single generation pipeline. Range: 1–10.
MAX_CONCURRENT_LLM_CALLS=8

# LLM API call timeout in seconds. Range: 10–300.
LLM_TIMEOUT_SECONDS=60

# Sampling temperature. Lower = more deterministic output. Range: 0.0–2.0.
LLM_TEMPERATURE=0.1

# Minimum acceptable extraction confidence from the LLM. Range: 0–100.
MIN_CONFIDENCE_THRESHOLD=80

# Max repair attempts when the code verifier finds issues. Range: 1–10.
MAX_VERIFIER_REPAIR_ATTEMPTS=4


# -----------------------------------------------------------------------------
# Default Automation Framework
# -----------------------------------------------------------------------------

# Framework used when the request does not specify one.
# Valid values: playwright | selenium | cypress | appium
AUTOMATION_FRAMEWORK=playwright


# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------

# Toggle rate limiting globally.
RATE_LIMIT_ENABLED=true

# Max requests per IP per window.
RATE_LIMIT_REQUESTS=100

# Sliding window size in seconds.
RATE_LIMIT_WINDOW_SECONDS=60


# -----------------------------------------------------------------------------
# Caching
# -----------------------------------------------------------------------------

# Toggle LLM response caching (avoids re-generating identical test cases).
CACHE_ENABLED=true

# How long a cached result is valid, in seconds.
CACHE_TTL_SECONDS=3600


# -----------------------------------------------------------------------------
# Redis  (optional — enables multi-worker rate limiting and caching)
# -----------------------------------------------------------------------------

# When set, Redis is used for both rate limiting and caching.
# When blank, in-memory backends are used (single-worker only).
# Format: redis://<host>:<port>/<db>
# REDIS_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# Batch Processing
# -----------------------------------------------------------------------------

# Maximum number of test cases in a single /batch/ request.
BATCH_MAX_ITEMS=50

# Default concurrency used by the batch processor.
BATCH_MAX_PARALLEL=5


# -----------------------------------------------------------------------------
# Circuit Breaker
# -----------------------------------------------------------------------------

CIRCUIT_BREAKER_ENABLED=true

# Number of consecutive failures before the circuit opens.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Seconds to wait before attempting recovery after the circuit opens.
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60


# -----------------------------------------------------------------------------
# Webhooks
# -----------------------------------------------------------------------------

# Per-request network timeout for outbound webhook calls, in seconds.
WEBHOOK_TIMEOUT_SECONDS=10

# Max retry attempts (uses exponential back-off with jitter).
WEBHOOK_MAX_RETRIES=3

# HMAC-SHA256 signing secret for outgoing webhook payloads.
# When set, every payload is signed and the X-Webhook-Signature header is added.
# Receivers can verify: hmac.new(secret, body, sha256).hexdigest()
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave commented out to disable payload signing.
# WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# File Cleanup
# -----------------------------------------------------------------------------

# Enable background task that deletes old generated scripts from disk.
CLEANUP_ENABLED=true

# Generated scripts older than this many hours are deleted.
CLEANUP_MAX_AGE_HOURS=24


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Comma-separated or JSON-list of allowed browser origins.
# ⚠ Wildcard (*) is BLOCKED when ENV=production — use explicit origins.
#
# Examples:
#   Single origin:   CORS_ORIGINS=https://app.yourcompany.com
#   Multiple:        CORS_ORIGINS=https://app.yourcompany.com,https://staging.yourcompany.com
#   Dev only:        CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=


# -----------------------------------------------------------------------------
# Authentication — JWT (Optional Layer)
# -----------------------------------------------------------------------------

# Enable JWT token validation on top of API key auth.
AUTH_ENABLED=false

# Signing secret for JWT tokens.
JWT_SECRET_KEY=

# JWT signing algorithm.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime in days.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7


# -----------------------------------------------------------------------------
# Metrics & Observability
# -----------------------------------------------------------------------------

# Expose /metrics/ endpoints.
METRICS_ENABLED=true

# Enable OpenTelemetry distributed tracing.
TRACING_ENABLED=false

# OTLP collector endpoint (used when TRACING_ENABLED=true).
TRACING_ENDPOINT=http://localhost:4317


# -----------------------------------------------------------------------------
# Code Generation Tuning
# -----------------------------------------------------------------------------

# Default Playwright expect() timeout in milliseconds.
EXPECT_TIMEOUT_MS=5000

# Default retry count for flaky steps.
DEFAULT_STEP_RETRIES=1
