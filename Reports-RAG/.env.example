# Application
APP_NAME=Reports RAG
APP_VERSION=1.0.0
ENV=development
TRUST_FORWARDED_IP=false
DEBUG=true
HOST=0.0.0.0
PORT=8000

# MongoDB
MONGO_ENABLED=true
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=reports_rag
MONGODB_BUCKET_NAME=reports

# Authentication
AUTH_REQUIRED=true
JWT_SECRET_KEY=replace-with-a-32-character-or-longer-secret
JWT_ALGORITHM=HS256

# Request limits
MAX_FILE_SIZE_MB=20
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Tracing and logging
ENABLE_TRACING=true
TRACE_SAMPLE_RATE=0.1
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000"]
