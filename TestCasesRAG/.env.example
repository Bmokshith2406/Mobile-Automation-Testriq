ENVIRONMENT=development
TRUST_FORWARDED_IP=false
FAIL_FAST_STARTUP=true

API_HOST=0.0.0.0
API_PORT=8001
LOG_LEVEL=INFO
LOG_FORMAT=json

MONGO_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_PUBLIC_USER_REGISTRATION=false

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

LLM_USE_GEMINI=true
LLM_USE_OPENAI=false
LLM_USE_ANTHROPIC=false
LLM_USE_LOCAL=false
REQUIRE_LLM_ON_STARTUP=false
LLM_TIMEOUT_SECONDS=60
LLM_RETRIES=2

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_URL=http://localhost:11434/v1/chat/completions
LOCAL_LLM_API_FORMAT=openai
LOCAL_LLM_EXTRA_HEADERS_JSON=

EMBEDDING_USE_MINILM_384=true
EMBEDDING_USE_MPNET_768=false
EMBEDDING_USE_BGE_LARGE_1024=false
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

CACHE_ENABLED=true
CACHE_BACKEND=auto
CACHE_KEY_PREFIX=testcasesrag
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000
REDIS_URL=

ENABLE_METRICS=true
ENABLE_TRACING=true
TRACE_SAMPLE_RATE=0.1

QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSIONS=6
GEMINI_RERANK_ENABLED=true
REQUIRE_GEMINI_ON_STARTUP=false

MAX_QUERY_LENGTH=5000
MAX_FILE_SIZE_MB=10
MAX_CONCURRENT_LLM_CALLS=10

INGESTION_WORKER_COUNT=1
INGESTION_QUEUE_MAX_SIZE=100
INGESTION_JOB_RETENTION_HOURS=24
